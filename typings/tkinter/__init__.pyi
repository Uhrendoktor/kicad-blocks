"""Minimal public Tkinter contract used by KiCad Blocks.

This stub intentionally models only the methods and widget classes consumed by
the plugin. Runtime Tkinter remains lazily imported by the application.
"""

from collections.abc import Mapping, Sequence
from typing import Callable, Generic, TypeVar

_W = TypeVar("_W")
TkOption = (
    str
    | int
    | float
    | bool
    | bytes
    | None
    | tuple[str | int | float, ...]
    | Variable
    | PhotoImage
    | Sequence[str | int | float | bool | bytes | None]
    | Callable[..., str | None]
)

class TclError(Exception): ...

class Event(Generic[_W]):
    widget: _W
    type: str
    num: int | None
    delta: int | float
    x: int
    y: int
    width: int
    height: int
    keysym: str
    char: str

class Variable:
    def __init__(
        self,
        master: Misc | None = ...,
        value: str | int | float | bool | None = ...,
        name: str | None = ...,
    ) -> None: ...
    def get(self) -> str | int | float | bool: ...
    def set(self, value: str | int | float | bool) -> None: ...
    def trace_add(self, mode: str, callback: Callable[..., None]) -> str: ...

class StringVar(Variable):
    def __init__(
        self, master: Misc | None = ..., value: str | None = ..., name: str | None = ...
    ) -> None: ...
    def get(self) -> str: ...
    def set(self, value: str) -> None: ...

class PhotoImage:
    def __init__(
        self,
        name: str | None = ...,
        cnf: Mapping[str, TkOption] | None = ...,
        master: Misc | None = ...,
        **kwargs: TkOption,
    ) -> None: ...
    def width(self) -> int: ...
    def height(self) -> int: ...
    def blank(self) -> None: ...

class Misc:
    master: Misc | None
    def __init__(self, master: Misc | None = ..., **kwargs: TkOption) -> None: ...
    def after(self, ms: int, callback: Callable[..., None], *args: TkOption) -> str: ...
    def after_cancel(self, identifier: str) -> None: ...
    def bind(
        self, sequence: str, func: Callable[..., str | None] | None = ..., add: str | None = ...
    ) -> str | None: ...
    def bind_all(
        self, sequence: str, func: Callable[..., str | None] | None = ..., add: str | None = ...
    ) -> str | None: ...
    def bind_class(
        self,
        class_name: str,
        sequence: str,
        func: Callable[..., str | None] | None = ...,
        add: str | None = ...,
    ) -> str | None: ...
    def cget(self, key: str) -> str: ...
    def configure(
        self, cnf: Mapping[str, TkOption] | str | None = ..., **kwargs: TkOption
    ) -> dict[str, TkOption] | None: ...
    config = configure
    def destroy(self) -> None: ...
    def event_generate(self, sequence: str, **kwargs: TkOption) -> None: ...
    def focus_set(self) -> None: ...
    def focus_force(self) -> None: ...
    def focus_get(self) -> Misc | None: ...
    def grab_set(self) -> None: ...
    def grab_release(self) -> None: ...
    def geometry(self, value: str | None = ...) -> str: ...
    def grid(self, **kwargs: TkOption) -> None: ...
    def grid_columnconfigure(self, index: int, **kwargs: TkOption) -> None: ...
    def grid_rowconfigure(self, index: int, **kwargs: TkOption) -> None: ...
    def columnconfigure(self, index: int, **kwargs: TkOption) -> None: ...
    def rowconfigure(self, index: int, **kwargs: TkOption) -> None: ...
    def mainloop(self, n: int = ...) -> None: ...
    def maxsize(self, width: int | None = ..., height: int | None = ...) -> tuple[int, int]: ...
    def minsize(self, width: int | None = ..., height: int | None = ...) -> tuple[int, int]: ...
    def option_add(self, pattern: str, value: TkOption, priority: int | str = ...) -> None: ...
    def pack(self, **kwargs: TkOption) -> None: ...
    def pack_forget(self) -> None: ...
    def place(self, **kwargs: TkOption) -> None: ...
    def place_forget(self) -> None: ...
    def protocol(self, name: str, callback: Callable[..., None] | None = ...) -> str | None: ...
    def resizable(self, width: bool | None = ..., height: bool | None = ...) -> tuple[int, int]: ...
    def title(self, string: str | None = ...) -> str: ...
    def transient(self, master: Misc | None = ...) -> None: ...
    def update(self) -> None: ...
    def update_idletasks(self) -> None: ...
    def wait_window(self, window: Misc | None = ...) -> None: ...
    def winfo_children(self) -> list[Misc]: ...
    def winfo_exists(self) -> bool: ...
    def winfo_height(self) -> int: ...
    def winfo_id(self) -> int: ...
    def winfo_ismapped(self) -> bool: ...
    def winfo_reqheight(self) -> int: ...
    def winfo_reqwidth(self) -> int: ...
    def winfo_rootx(self) -> int: ...
    def winfo_rooty(self) -> int: ...
    def winfo_screenheight(self) -> int: ...
    def winfo_screenwidth(self) -> int: ...
    def winfo_toplevel(self) -> Misc: ...
    def winfo_width(self) -> int: ...
    def withdraw(self) -> None: ...
    def deiconify(self) -> None: ...
    def iconify(self) -> None: ...
    def state(self, state: str | None = ...) -> str: ...
    def wm_attributes(
        self, *args: str | bool | float
    ) -> str | bool | float | tuple[str, ...] | None: ...
    def wm_class(self, *args: str) -> str | tuple[str, str] | None: ...
    def wm_overrideredirect(self, boolean: bool | None = ...) -> bool: ...
    def wm_title(self, string: str | None = ...) -> str: ...
    def xview(self, *args: str | int) -> tuple[float, float]: ...
    def xview_moveto(self, fraction: float) -> None: ...
    def xview_scroll(self, number: int, what: str) -> None: ...
    def yview(self, *args: str | int) -> tuple[float, float]: ...
    def yview_moveto(self, fraction: float) -> None: ...
    def yview_scroll(self, number: int, what: str) -> None: ...

