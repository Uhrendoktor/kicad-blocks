"""Narrow ttk widget contracts consumed by KiCad Blocks."""
from collections.abc import Mapping
from typing import Callable
from tkinter import Misc, PhotoImage, TkOption, Variable

class Widget(Misc): ...
class Frame(Widget):
    def __init__(self, master: Misc | None = ..., cnf: Mapping[str, TkOption] | None = ..., **kwargs: TkOption) -> None: ...
class Label(Widget):
    def __init__(self, master: Misc | None = ..., cnf: Mapping[str, TkOption] | None = ..., **kwargs: TkOption) -> None: ...
class LabelFrame(Frame):
    def __init__(self, master: Misc | None = ..., cnf: Mapping[str, TkOption] | None = ..., **kwargs: TkOption) -> None: ...
class Button(Widget):
    def __init__(self, master: Misc | None = ..., cnf: Mapping[str, TkOption] | None = ..., **kwargs: TkOption) -> None: ...
    def invoke(self) -> str: ...
class Entry(Widget):
    def __init__(self, master: Misc | None = ..., cnf: Mapping[str, TkOption] | None = ..., **kwargs: TkOption) -> None: ...
    def delete(self, first: int | str, last: int | str | None = ...) -> None: ...
    def get(self) -> str: ...
    def insert(self, index: int | str, text: str) -> None: ...
    def selection_range(self, start: int, end: int) -> None: ...
class Combobox(Entry):
    def current(self, newindex: int | None = ...) -> int: ...
    def set(self, value: str) -> None: ...
class Scrollbar(Widget):
    def __init__(self, master: Misc | None = ..., cnf: Mapping[str, TkOption] | None = ..., **kwargs: TkOption) -> None: ...
    def set(self, first: str, last: str) -> None: ...
class Separator(Widget):
    def __init__(self, master: Misc | None = ..., cnf: Mapping[str, TkOption] | None = ..., **kwargs: TkOption) -> None: ...
class Panedwindow(Widget):
    def __init__(self, master: Misc | None = ..., cnf: Mapping[str, TkOption] | None = ..., **kwargs: TkOption) -> None: ...
    def add(self, child: Misc, **kwargs: TkOption) -> None: ...
class Notebook(Widget):
    def __init__(self, master: Misc | None = ..., cnf: Mapping[str, TkOption] | None = ..., **kwargs: TkOption) -> None: ...
    def add(self, child: Misc, **kwargs: TkOption) -> None: ...
    def select(self, tab_id: str | None = ...) -> str: ...
    def tab(self, tab_id: str, option: str | None = ..., **kwargs: TkOption) -> str | dict[str, TkOption]: ...
    def tabs(self) -> tuple[str, ...]: ...
class Treeview(Widget):
    def __init__(self, master: Misc | None = ..., cnf: Mapping[str, TkOption] | None = ..., **kwargs: TkOption) -> None: ...
    def bbox(self, item: str, column: str | int | None = ...) -> tuple[int, int, int, int] | str: ...
    def column(self, column: str, option: str | None = ..., **kwargs: TkOption) -> TkOption | dict[str, TkOption]: ...
    def delete(self, *items: str) -> None: ...
    def exists(self, item: str) -> bool: ...
    def focus(self, item: str | None = ...) -> str: ...
    def get_children(self, item: str | None = ...) -> tuple[str, ...]: ...
    def heading(self, column: str, option: str | None = ..., **kwargs: TkOption) -> TkOption | dict[str, TkOption]: ...
    def identify_row(self, y: int) -> str: ...
    def insert(self, parent: str, index: int | str, iid: str | None = ..., **kwargs: TkOption) -> str: ...
    def item(self, item: str, option: str | None = ..., **kwargs: TkOption) -> TkOption | dict[str, TkOption]: ...
    def selection(self) -> tuple[str, ...]: ...
    def selection_remove(self, *items: str) -> None: ...
    def selection_set(self, *items: str) -> None: ...
    def set(self, item: str, column: str | None = ..., value: str | None = ...) -> str | dict[str, str]: ...
class Style:
    def __init__(self, master: Misc | None = ...) -> None: ...
    def configure(self, style: str, cnf: Mapping[str, TkOption] | None = ..., **kwargs: TkOption) -> dict[str, TkOption] | None: ...
    def map(self, style: str, cnf: Mapping[str, TkOption] | None = ..., **kwargs: TkOption) -> dict[str, TkOption] | None: ...
    def lookup(self, style: str, option: str, state: tuple[str, ...] = ..., default: str | None = ...) -> str: ...
    def theme_use(self, theme: str | None = ...) -> str: ...
    def layout(self, style: str, layoutspec: list[tuple[str, dict[str, TkOption]]] | None = ...) -> list[tuple[str, dict[str, TkOption]]]: ...
