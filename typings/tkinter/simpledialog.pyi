"""Typed subset of tkinter.simpledialog used by KiCad Blocks."""

from tkinter import Misc, TkOption

def askfloat(title: str, prompt: str, *, parent: Misc | None = ..., **options: TkOption) -> float | None: ...
def askinteger(title: str, prompt: str, *, parent: Misc | None = ..., **options: TkOption) -> int | None: ...
def askstring(title: str, prompt: str, *, parent: Misc | None = ..., **options: TkOption) -> str | None: ...
