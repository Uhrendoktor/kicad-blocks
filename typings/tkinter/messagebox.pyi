"""Typed subset of tkinter.messagebox used by KiCad Blocks."""

from tkinter import Misc, TkOption

def askyesno(title: str, message: str, *, parent: Misc | None = ..., **options: TkOption) -> bool: ...
def askokcancel(title: str, message: str, *, parent: Misc | None = ..., **options: TkOption) -> bool: ...
def showerror(title: str, message: str, *, parent: Misc | None = ..., **options: TkOption) -> str: ...
def showinfo(title: str, message: str, *, parent: Misc | None = ..., **options: TkOption) -> str: ...
def showwarning(title: str, message: str, *, parent: Misc | None = ..., **options: TkOption) -> str: ...
