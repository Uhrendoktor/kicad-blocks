{
  "include": [
    "plugin/kicad-blocks",
    "scripts",
    "examples"
  ],
  "exclude": [
    "**/__pycache__",
    "**/.pytest_cache",
    "**/.ruff_cache",
    "**/.venv",
    "tests"
  ],
  "extraPaths": [
    "plugin/kicad-blocks"
  ],
  "typeCheckingMode": "strict",
  "pythonVersion": "3.12",
  "pythonPlatform": "Linux",
  "reportMissingImports": "none",
  "reportMissingModuleSource": "none"
}
